# Apptio-Tools Environment Variables Configuration
# Copy this file to .env and fill in your credentials
# The .env file will be automatically loaded by the scripts (requires python-dotenv)

# ============================================================================
# AUTHENTICATION - Choose ONE method below
# ============================================================================

# Option 1: Cloudability API Key Authentication
# ----------------------------------------------
# Get your API key from: Cloudability UI → Profile → Preferences → API Key
CLOUDABILITY_API_KEY=your_api_key_here

# Option 2: Frontdoor Public/Private Key Authentication
# ------------------------------------------------------
# Get your keys from: Apptio Platform → Settings → API Keys
# APPTIO_PUBLIC_KEY=your_public_key_here
# APPTIO_PRIVATE_KEY=your_private_key_here
# APPTIO_DOMAIN=your_domain_name
# APPTIO_ENVIRONMENT_NAME=main
# APPTIO_REGION=

# ============================================================================
# REGION CONFIGURATION (Optional)
# ============================================================================
# Leave empty for US region, or set to: "eu", "au", "me"
# APPTIO_REGION=

# ============================================================================
# NOTES
# ============================================================================
# - Never commit the actual .env file to version control
# - The .env file is already in .gitignore
# - You only need to set ONE authentication method (API Key OR Frontdoor)
# - Environment variables take precedence over command-line arguments
# - Install python-dotenv for automatic .env loading: pip install python-dotenv